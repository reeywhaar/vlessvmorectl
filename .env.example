# Copy to .env. It holds a full-control token for every node — do not commit it.
#
#   cp .env.example .env
#
# Format: a comma-separated list of url|token. Newlines work too, so a compose block
# scalar reads naturally.

# Recommended: the panel and the nodes share a Docker network, and no node publishes its
# management API to the internet at all. This is only possible because the panel proxies
# — the browser never contacts a node directly.
VLESSVMORE_SERVERS="http://vlessvmore-nl:80|MHDJWEZ5NQ7K2P8RTX4VYB6CFA3GS1WD"

# Across the internet instead, where the token crosses the network and must be encrypted:
#
#   VLESSVMORE_SERVERS="https://vpn-nl.example.com|TOKEN1,https://vpn-de.example.com|TOKEN2"

# Mint each token on the node itself. The secret is shown once and never again:
#
#   docker exec vlessvmore vlessvmore token create panel --raw

# debug, info (default), warn, error
# VLESSVMORE_LOG_LEVEL=info
