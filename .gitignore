/private

# Holds admins.json. Never commit it.
/data/

# Local archives, if you run the backup sidecar from this checkout. Same contents as
# /data, so the same rule applies.
/backups/

# Holds VLESSVMORE_SERVERS, i.e. full-control tokens for every node.
.env

/web/node_modules

# TypeScript's incremental build cache. Regenerated by every `tsc -b`, so committing it
# is pure diff noise and a reliable source of merge conflicts.
*.tsbuildinfo

# The built bundle is ignored, but .gitkeep must stay tracked: web/embed.go does
# //go:embed all:dist, and an absent directory is a compile error, not an empty
# embed. Without this exception a fresh clone cannot `go build` or `go test`.
# Hence `dist/*` rather than `dist` — git will not descend into an ignored directory
# to find the exception.
/web/dist/*
!/web/dist/.gitkeep

/vlessvmorectl
